{
  "name": "ctx-flow",
  "version": "1.1.0",
  "description": "Intent-aware context injection MCP plugin for Claude Code. Reduces token usage by 60-98% on long sessions.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ctx-flow": "bin/ctx-flow.js"
  },
  "files": [
    "dist",
    "bin",
    "context",
    "ctx-flow.config.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "model-context-protocol",
    "context",
    "memory",
    "anthropic",
    "llm",
    "token-optimization",
    "intent-routing"
  ],
  "author": "bhunesh bansal",
  "license": "MIT",
  "homepage": "https://github.com/bansalbhunesh/ctx-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bansalbhunesh/ctx-flow.git"
  },
  "bugs": {
    "url": "https://github.com/bansalbhunesh/ctx-flow/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@modelcontextprotocol/sdk": "^1.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  }
}
